---
// src/components/CornDashboard.astro
//
// Interactive corn disease risk dashboard. Imported from the
// corn-dashboard.mdx content entry and rendered inside the standard
// project detail chrome (Layout → container-narrow → prose-editorial).
//
// All site-year JSON is imported at build time via import.meta.glob
// from src/data/corn-dashboard/. Files in public/ are not visible to
// Vite globs — that's why the data lives in src/.
//
// All theming uses the existing tokens from src/styles/global.css
// (--bg-elevated, --surface, --surface-2, --border, --text,
// --text-muted, --accent, --accent-soft). Light and dark mode flip
// automatically with [data-theme] on <html>.

const siteYears = import.meta.glob('../data/corn-dashboard/*.json', { eager: true });

const datasets: Record<string, any> = {};
for (const [path, mod] of Object.entries(siteYears)) {
  const fname = path.split('/').pop()!;
  if (fname === 'index.json') continue;  // not a site-year payload
  const payload = (mod as any).default ?? mod;
  datasets[fname.replace('.json', '')] = payload;
}

// Derive sites and years from the actual payloads, not from index.json.
// index.json can be stale (subsequent pipeline runs may have rewritten it
// with only a subset), but the JSON files on disk are the source of truth.
const allPayloads = Object.values(datasets) as any[];
const siteMap = new Map<string, string>();
allPayloads.forEach((d) => {
  if (d?.site && !siteMap.has(d.site)) siteMap.set(d.site, d.site_name ?? d.site);
});
const sites = Array.from(siteMap.entries()).map(([code, name]) => ({ code, name }));
const years = Array.from(new Set(allPayloads.map((d) => d.year).filter((y) => y != null)))
  .sort((a: number, b: number) => b - a);
const defaultSite = sites.find((s) => s.code === 'pds') ? 'pds' : sites[0]?.code ?? '';
const defaultYear = years[0] ?? new Date().getFullYear();
const hasData = sites.length > 0 && years.length > 0;
---

<div class="cd-wrap">
  {hasData ? (
    <>
      <div class="cd-controls" role="group" aria-label="Dashboard filters">
        <label class="cd-control">
          <span>Site</span>
          <select id="cd-site">
            {sites.map((s) => (
              <option value={s.code} selected={s.code === defaultSite}>
                {s.name}
              </option>
            ))}
          </select>
        </label>
        <label class="cd-control">
          <span>Year</span>
          <select id="cd-year">
            {years.map((y) => (
              <option value={y} selected={y === defaultYear}>
                {y}{y === new Date().getFullYear() ? ' · live' : ''}
              </option>
            ))}
          </select>
        </label>
      </div>

      <section class="cd-cards" aria-label="Disease risk summary">
        <article class="cd-card">
          <h3>Tar spot</h3>
          <p class="cd-bignum" id="cd-tarspot-peak">—</p>
          <p class="cd-cardmeta">peak risk · <span id="cd-tarspot-days">—</span> d ≥ 35%</p>
          <p class="cd-srcite">Webster 2023 ensemble</p>
        </article>
        <article class="cd-card">
          <h3>Gibberella ear rot</h3>
          <p class="cd-bignum" id="cd-ger-days">—</p>
          <p class="cd-cardmeta">conducive days · <span id="cd-ger-silk">—</span> in silking</p>
          <p class="cd-srcite">T ≥ 15 °C, RH ≥ 80 %</p>
        </article>
        <article class="cd-card">
          <h3>Fusarium ear rot</h3>
          <p class="cd-bignum" id="cd-fer-days">—</p>
          <p class="cd-cardmeta">conducive days · <span id="cd-fer-silk">—</span> in silking</p>
          <p class="cd-srcite">20–35 °C, RH ≥ 70 %</p>
        </article>
        <article class="cd-card">
          <h3>Southern rust</h3>
          <p class="cd-bignum" id="cd-srust-peak">—</p>
          <p class="cd-cardmeta">peak risk · <span id="cd-srust-days">—</span> d conducive · <span id="cd-srust-silk">—</span> in silking</p>
          <p class="cd-srcite"><span id="cd-srust-tier" class="cd-tier-pill">—</span></p>
        </article>
        <article class="cd-card">
          <h3>Mycotoxin risk</h3>
          <p class="cd-bignum cd-bignum-text" id="cd-myco-category">—</p>
          <p class="cd-cardmeta"><span id="cd-myco-dominant">—</span> · silking mean <span id="cd-myco-mean">—</span></p>
          <p class="cd-srcite">Hazard index · DON + fumonisin</p>
        </article>
      </section>

      <section class="cd-chart-section">
        <div class="cd-chart-head">
          <h3>Seasonal timeline</h3>
          <div class="cd-tabs" role="tablist" aria-label="Disease risk series">
            <button type="button" class="cd-tab cd-tab-active" role="tab" aria-selected="true" data-disease="tarspot">Tar spot</button>
            <button type="button" class="cd-tab" role="tab" aria-selected="false" data-disease="srust">Southern rust</button>
            <button type="button" class="cd-tab" role="tab" aria-selected="false" data-disease="mycotoxin">Mycotoxin</button>
          </div>
        </div>
        <div class="cd-legend" id="cd-legend"></div>
        <div class="cd-chart-wrap">
          <canvas
            id="cd-chart"
            role="img"
            aria-label="Daily temperature, relative humidity, and disease risk indices for the selected site and year, with the silking window highlighted."
          >
            Daily temperature, RH, and disease risk indices for the selected site-year.
          </canvas>
        </div>
        <p class="cd-chart-note" id="cd-silking-note"></p>
      </section>

      <section class="cd-bottom">
        <article class="cd-panel" id="cd-scouting-panel">
          <h3>Scouting observations</h3>
          <div id="cd-scouting-body">
            <p class="cd-muted">No on-farm scouting recorded for the selected site-year.</p>
          </div>
        </article>
        <article class="cd-panel">
          <h3>Site &amp; data</h3>
          <dl class="cd-defs">
            <dt>Location</dt><dd id="cd-meta-site">—</dd>
            <dt>Year</dt><dd id="cd-meta-year">—</dd>
            <dt>Weather source</dt><dd id="cd-meta-source">—</dd>
            <dt>Planting</dt><dd id="cd-meta-planting">—</dd>
            <dt>Silking</dt><dd id="cd-meta-silking">—</dd>
            <dt>Generated</dt><dd id="cd-meta-generated">—</dd>
          </dl>
        </article>
      </section>
    </>
  ) : (
    <div class="cd-empty">
      <p>
        No dashboard data is committed yet at <code>src/data/corn-dashboard/</code>. Run the
        pipeline once (see <code>tools/corndash/README.md</code>) and rebuild.
      </p>
    </div>
  )}
</div>

{hasData && (
  <>
    <script id="cd-data" type="application/json" is:inline set:html={JSON.stringify(datasets)} />

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js" is:inline />
    <script is:inline>
      (function () {
        const datasets = JSON.parse(document.getElementById('cd-data').textContent);
        const siteSel = document.getElementById('cd-site');
        const yearSel = document.getElementById('cd-year');
        let chart = null;

        // Chart palette: pulls site tokens for muted UI; uses dedicated
        // chart colors for series so they remain distinguishable across
        // both themes.
        function tok(name, fallback) {
          try {
            const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
            return v || fallback;
          } catch (_) { return fallback; }
        }
        function chartColors() {
          const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
          return {
            temp: isDark ? '#e88c7a' : '#c05a3f',
            rh:   isDark ? '#7aa6e8' : '#3a6ca6',
            tarspot:  isDark ? '#fbbf24' : '#d97706',  // amber
            srust:    isDark ? '#ef4444' : '#b91c1c',  // rust red
            mycotoxin:isDark ? '#a78bfa' : '#7e22ce',  // purple
            ger: tok('--accent', isDark ? '#8eb190' : '#2f5734'),
            fer: isDark ? '#fb923c' : '#ea580c',       // orange
            muted: tok('--text-muted', '#6b6b66'),
            grid: isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.06)',
          };
        }

        // Tracks which disease's risk series is shown on the chart.
        let currentDisease = 'tarspot';

        function fmtPct(x) { return x == null ? '—' : Math.round(x * 100) + '%'; }
        function fmtDate(s) {
          if (!s) return '—';
          const d = new Date(s);
          return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        }
        function setText(id, value) {
          const el = document.getElementById(id);
          if (el) el.textContent = value == null || value === '' ? '—' : value;
        }

        function render() {
          const key = siteSel.value + '_' + yearSel.value;
          const d = datasets[key];
          if (!d) {
            ['cd-tarspot-peak','cd-tarspot-days','cd-ger-days','cd-ger-silk',
             'cd-fer-days','cd-fer-silk','cd-meta-site','cd-meta-year',
             'cd-meta-source','cd-meta-planting','cd-meta-silking','cd-meta-generated']
              .forEach(id => setText(id, '—'));
            document.getElementById('cd-silking-note').textContent =
              'No data available for ' + siteSel.value + ' ' + yearSel.value + '.';
            if (chart) { chart.destroy(); chart = null; }
            document.getElementById('cd-scouting-body').innerHTML =
              '<p class="cd-muted">No data available for this site-year.</p>';
            return;
          }

          setText('cd-tarspot-peak', fmtPct(d.summary.tarspot_peak_risk));
          setText('cd-tarspot-days', d.summary.tarspot_days_above_threshold ?? 0);
          setText('cd-ger-days', d.summary.ger_conducive_days);
          setText('cd-ger-silk', d.summary.ger_silking_window_sum ?? '—');
          setText('cd-fer-days', d.summary.fer_conducive_days);
          setText('cd-fer-silk', d.summary.fer_silking_window_sum ?? '—');

          // Southern rust card
          setText('cd-srust-peak', fmtPct(d.summary.srust_peak_risk));
          setText('cd-srust-days', d.summary.srust_conducive_days ?? 0);
          setText('cd-srust-silk', d.summary.srust_silking_window_sum ?? '—');
          const tier = d.summary.srust_arrival_tier || 'none';
          const tierLabels = {
            local: 'Local (WI)', adjacent: 'Adjacent', regional: 'Regional',
            southern: 'Southern only', none: 'No arrivals'
          };
          const tierEl = document.getElementById('cd-srust-tier');
          tierEl.textContent = tierLabels[tier] || tier;
          tierEl.dataset.tier = tier;

          // Mycotoxin card
          setText('cd-myco-category', d.summary.mycotoxin_category || '—');
          setText('cd-myco-dominant', d.summary.mycotoxin_dominant || '—');
          const mxMean = d.summary.mycotoxin_silking_mean;
          setText('cd-myco-mean', mxMean == null ? '—' : mxMean.toFixed(2));

          setText('cd-meta-site', d.site_name);
          setText('cd-meta-year', d.year);
          setText('cd-meta-source', d.data_source);
          setText('cd-meta-planting', fmtDate(d.phenology.planting_date));
          setText('cd-meta-silking',
            d.phenology.silking_date
              ? fmtDate(d.phenology.silking_date) + ' · ' + Math.round(d.phenology.hybrid_gdd_to_silk_c) + ' GDD °C'
              : 'using ' + d.phenology.source.replace(/_/g, ' '));
          setText('cd-meta-generated', d.generated_at.split('T')[0]);

          document.getElementById('cd-silking-note').textContent =
            'Silking window: ' + fmtDate(d.phenology.window_start) + ' through ' +
            fmtDate(d.phenology.window_end) +
            '. Tar spot risk is masked outside the agronomic validity window.';

          const labels = d.daily.map(r => r.date);
          const tempMean = d.daily.map(r => r.temp_mean);
          const rhMean = d.daily.map(r => r.rh_mean);
          const C = chartColors();

          // Disease-specific series + legend, switched by the tab control.
          const riskSeries = {
            tarspot: {
              color: C.tarspot,
              values: d.daily.map(r => r.tarspot_risk == null ? null : r.tarspot_risk * 100),
              label: 'Tar spot risk · Webster ensemble (%)',
              markers: [
                { color: C.ger, label: 'Gibberella conducive day',
                  data: d.daily.map(r => r.ger_conducive ? 47 : null), style: 'crossRot' },
              ],
            },
            srust: {
              color: C.srust,
              values: d.daily.map(r => r.srust_risk == null ? null : r.srust_risk * 100),
              label: 'Southern rust risk · local × arrival (%)',
              markers: [
                { color: C.srust, label: 'Southern rust conducive day',
                  data: d.daily.map(r => r.srust_conducive ? 47 : null), style: 'crossRot' },
              ],
            },
            mycotoxin: {
              color: C.mycotoxin,
              values: d.daily.map(r => r.mycotoxin_score == null ? null : r.mycotoxin_score * 100),
              label: 'Mycotoxin hazard index (DON+fumonisin, %) · ear susceptibility window',
              markers: [
                { color: C.ger, label: 'Gibberella conducive day',
                  data: d.daily.map(r => r.ger_conducive ? 47 : null), style: 'crossRot' },
                { color: C.fer, label: 'Fusarium conducive day',
                  data: d.daily.map(r => r.fer_conducive ? 44 : null), style: 'cross' },
              ],
            },
          }[currentDisease];

          // The silking band shows on every tab, but with a different
          // semantic depending on the disease:
          //   tar spot   — model validity window from the Webster paper
          //   srust      — yield-critical period for foliar damage
          //   mycotoxin  — ear susceptibility window for infection
          const silkLabel = {
            tarspot:   'Silking window (model validity)',
            srust:     'Silking window (yield-critical period)',
            mycotoxin: 'Silking window (ear susceptibility)',
          }[currentDisease];

          const silkStart = d.phenology.window_start;
          const silkEnd = d.phenology.window_end;
          const silkStartIdx = labels.findIndex(x => x >= silkStart);
          const silkEndIdx = labels.findIndex(x => x > silkEnd);

          // Use the currently-selected disease's color for the silking band
          // so the highlight visually pairs with the risk series.
          const seriesColorRgba = (alpha) => {
            // crude: pull the named color and apply alpha through canvas
            const c = document.createElement('canvas').getContext('2d');
            c.fillStyle = riskSeries.color;
            const hex = c.fillStyle;
            const n = parseInt(hex.slice(1), 16);
            const r = (n >> 16) & 255, g = (n >> 8) & 255, b = n & 255;
            return `rgba(${r},${g},${b},${alpha})`;
          };

          const silkOverlay = {
            id: 'silk',
            beforeDraw(c) {
              if (silkStartIdx < 0) return;
              const xs = c.scales.x.getPixelForValue(silkStartIdx);
              const xe = silkEndIdx < 0
                ? c.scales.x.getPixelForValue(labels.length - 1)
                : c.scales.x.getPixelForValue(silkEndIdx);
              c.ctx.save();
              c.ctx.fillStyle = seriesColorRgba(0.10);
              c.ctx.fillRect(xs, c.chartArea.top, xe - xs, c.chartArea.bottom - c.chartArea.top);
              c.ctx.strokeStyle = seriesColorRgba(0.40);
              c.ctx.setLineDash([3, 3]);
              c.ctx.beginPath();
              c.ctx.moveTo(xs, c.chartArea.top); c.ctx.lineTo(xs, c.chartArea.bottom);
              c.ctx.moveTo(xe, c.chartArea.top); c.ctx.lineTo(xe, c.chartArea.bottom);
              c.ctx.stroke();
              c.ctx.restore();
            }
          };

          if (chart) chart.destroy();
          const ctx = document.getElementById('cd-chart').getContext('2d');
          const datasets_ = [
            { type: 'line', label: 'Temp (°C)', data: tempMean,
              borderColor: C.temp, backgroundColor: 'transparent',
              borderWidth: 1.4, pointRadius: 0, tension: 0.25, yAxisID: 'y' },
            { type: 'line', label: 'RH (%)', data: rhMean,
              borderColor: C.rh, backgroundColor: 'transparent',
              borderWidth: 1.4, pointRadius: 0, tension: 0.25,
              yAxisID: 'y1', borderDash: [4, 3] },
            { type: 'line', label: riskSeries.label, data: riskSeries.values,
              borderColor: riskSeries.color, backgroundColor: seriesColorRgba(0.12),
              borderWidth: 1.8, pointRadius: 0, tension: 0.2,
              yAxisID: 'y1', fill: true, spanGaps: false },
          ];
          riskSeries.markers.forEach(m => {
            datasets_.push({
              type: 'scatter', label: m.label,
              data: m.data.map((v, i) => v == null ? null : { x: labels[i], y: v }),
              backgroundColor: m.color, pointRadius: 4.5, pointStyle: m.style, yAxisID: 'y',
            });
          });

          chart = new Chart(ctx, {
            data: { labels, datasets: datasets_ },
            options: {
              responsive: true, maintainAspectRatio: false,
              interaction: { mode: 'index', intersect: false },
              plugins: { legend: { display: false }, tooltip: { mode: 'index', intersect: false } },
              scales: {
                x: { ticks: { maxTicksLimit: 8, font: { size: 10 }, color: C.muted },
                     grid: { display: false } },
                y: { position: 'left', title: { display: true, text: '°C', color: C.muted, font: { size: 10 } },
                     min: 0, max: 50, ticks: { font: { size: 10 }, color: C.muted },
                     grid: { color: C.grid } },
                y1: { position: 'right', title: { display: true, text: 'RH % / risk %', color: C.muted, font: { size: 10 } },
                      min: 0, max: 100, ticks: { font: { size: 10 }, color: C.muted },
                      grid: { display: false } }
              }
            },
            plugins: [silkOverlay]
          });

          // Legend rendered to match the current tab's series.
          const legendDefs = [
            { kind: 'line',   color: C.temp, label: 'Daily mean temperature (°C)' },
            { kind: 'dashed', color: C.rh,   label: 'Daily mean relative humidity (%)' },
            { kind: 'area',   color: riskSeries.color, label: riskSeries.label },
          ];
          riskSeries.markers.forEach(m => {
            legendDefs.push({ kind: 'cross', color: m.color, label: m.label });
          });
          legendDefs.push({ kind: 'shade', color: riskSeries.color, label: silkLabel });

          document.getElementById('cd-legend').innerHTML = legendDefs.map(it => {
            let swatch;
            if (it.kind === 'line')        swatch = '<span class="cd-sw cd-sw-line" style="--c:' + it.color + '"></span>';
            else if (it.kind === 'dashed') swatch = '<span class="cd-sw cd-sw-dashed" style="--c:' + it.color + '"></span>';
            else if (it.kind === 'area')   swatch = '<span class="cd-sw cd-sw-area" style="--c:' + it.color + '"></span>';
            else if (it.kind === 'cross')  swatch = '<span class="cd-sw cd-sw-cross" style="color:' + it.color + '">✕</span>';
            else if (it.kind === 'shade')  swatch = '<span class="cd-sw cd-sw-shade" style="--c:' + it.color + '"></span>';
            return '<span class="cd-legitem">' + swatch + '<span>' + it.label + '</span></span>';
          }).join('');

          const sb = document.getElementById('cd-scouting-body');
          if (!d.scouting || d.scouting.length === 0) {
            sb.innerHTML = '<p class="cd-muted">No on-farm scouting recorded for this site-year.</p>';
          } else {
            const byField = {};
            d.scouting.forEach(r => {
              const k = r.field + ' · ' + r.date;
              (byField[k] = byField[k] || []).push(r);
            });
            sb.innerHTML = Object.entries(byField).map(([k, arr]) => {
              const pctVals = arr.map(r => r.southern_rust && r.southern_rust.incidence_pct).filter(v => v != null);
              const meanPct = pctVals.length ? Math.round(pctVals.reduce((a, b) => a + b, 0) / pctVals.length) : null;
              const cats = arr.map(r => r.southern_rust && r.southern_rust.incidence_category).filter(Boolean);
              return '<div class="cd-scoutrow">' +
                '<div class="cd-scoutkey">Field ' + k + '</div>' +
                '<div class="cd-scoutval">' +
                  arr.length + ' points · SR incidence ' +
                  (meanPct != null ? meanPct + '%' : (cats.length ? cats.join(', ') : '—')) +
                '</div></div>';
            }).join('');
          }
        }

        siteSel.addEventListener('change', render);
        yearSel.addEventListener('change', render);

        // Tab control: swap the chart's risk series + legend.
        document.querySelectorAll('.cd-tab').forEach(btn => {
          btn.addEventListener('click', () => {
            document.querySelectorAll('.cd-tab').forEach(b => {
              b.classList.remove('cd-tab-active');
              b.setAttribute('aria-selected', 'false');
            });
            btn.classList.add('cd-tab-active');
            btn.setAttribute('aria-selected', 'true');
            currentDisease = btn.dataset.disease;
            render();
          });
        });

        render();

        // Re-render chart when theme toggles so colors update.
        const observer = new MutationObserver(() => render());
        observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
      })();
    </script>
  </>
)}

<style is:global>
  /* Marked is:global because the legend swatches and scouting rows are
     inserted via innerHTML at runtime. Astro's scoped CSS uses a build-time
     attribute hash that runtime DOM nodes don't have, so without is:global
     those elements escape the styles entirely. All selectors are namespaced
     under `cd-*` so there's no collision risk with other components. */

  .cd-wrap {
    margin-block: 1.5rem 2rem;
    /* Break out of the .container-narrow / .prose-editorial flow visually
       by removing inherited prose margins on direct children. */
  }
  .cd-wrap section,
  .cd-wrap article {
    margin: 0;
  }

  .cd-controls {
    display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: flex-end;
    margin-bottom: 1.25rem;
  }
  .cd-control {
    display: flex; flex-direction: column; gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-subtle);
  }
  .cd-control select {
    background: var(--bg-elevated); color: var(--text);
    border: 1px solid var(--border);
    padding: 8px 12px; border-radius: 6px;
    font-family: var(--font-sans);
    font-size: 0.9rem; min-width: 200px;
    text-transform: none; letter-spacing: 0;
    cursor: pointer;
  }
  .cd-control select:focus-visible {
    outline: 2px solid var(--accent); outline-offset: 2px;
  }

  .cd-empty {
    background: var(--surface); border: 1px dashed var(--border);
    border-radius: 10px; padding: 1.25rem;
    color: var(--text-muted); font-size: 0.9rem;
  }
  .cd-empty code {
    font-family: var(--font-mono);
    background: var(--surface-2); padding: 1px 6px;
    border-radius: 3px; font-size: 0.85em;
  }

  .cd-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 8px;
    margin-bottom: 1.25rem;
  }
  .cd-card {
    background: var(--bg-elevated); border: 1px solid var(--border);
    border-radius: 8px; padding: 12px 14px;
  }
  .cd-card h3 {
    font-family: var(--font-sans);
    font-size: 0.78rem; font-weight: 500;
    color: var(--text-muted);
    margin: 0 0 6px;
    letter-spacing: 0;
    text-wrap: pretty;
  }
  .cd-bignum {
    font-family: var(--font-serif);
    font-size: 1.6rem; font-weight: 500;
    margin: 0; line-height: 1;
    color: var(--text);
    letter-spacing: -0.01em;
  }
  .cd-cardmeta {
    font-size: 0.72rem; color: var(--text-muted);
    margin: 6px 0 4px;
  }
