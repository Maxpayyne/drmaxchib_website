<style is:global>
  .nm-wrap { margin-block: 1.5rem; }
  .nm-hint { font-size:.8125rem; color:var(--text-subtle); margin-bottom:.625rem; display:flex; align-items:center; gap:.4rem; }
  .nm-pulse { width:7px; height:7px; border-radius:50%; background:var(--accent); display:inline-block; animation:nm-pulse 2s infinite; flex-shrink:0; }
  @keyframes nm-pulse { 0%,100%{opacity:1} 50%{opacity:.3} }

  .nm-map-container {
    position:relative; border:1px solid var(--border); border-radius:12px;
    overflow:hidden; background:#d4eaf7; touch-action:none; cursor:grab;
  }
  .nm-map-container:active { cursor:grabbing; }

  #nm-svg { width:100%; height:auto; display:block; transform-origin:0 0; user-select:none; -webkit-user-select:none; }
  #nm-svg .state { stroke:white; stroke-width:0.8; cursor:pointer; transition:filter .12s, stroke-width .12s; }
  #nm-svg .state:hover { filter:brightness(0.85); stroke-width:1.2; }
  #nm-svg .state.active { filter:brightness(0.72); stroke:#fff; stroke-width:1.5; }

  /* Zone-highlighted states get a bright ring but retain their base color */
  #nm-svg .state.zone-highlighted { stroke:#ffef00; stroke-width:2; filter:brightness(1.08); }
  #nm-svg .state.zone-highlighted.active { filter:brightness(0.72); stroke:#fff; stroke-width:1.5; }

  #nm-svg .sl { fill:#fff; pointer-events:none; text-anchor:middle; dominant-baseline:middle; font-weight:600; text-shadow:0 1px 2px rgba(0,0,0,.5); }

  .nm-reset-btn {
    position:absolute; top:.625rem; right:.625rem; width:34px; height:34px; padding:0;
    background:white; border:1px solid var(--border); border-radius:8px; cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    box-shadow:0 2px 8px rgba(0,0,0,.12); transition:background .15s;
  }
  .nm-reset-btn:hover { background:var(--surface); }
  .nm-reset-btn svg { width:18px; height:18px; color:var(--text); }

  /* ZONE LEGEND — clickable pills */
  .nm-zone-legend { display:flex; flex-wrap:wrap; gap:.4rem; margin-top:.625rem; margin-bottom:1.25rem; }

  .nm-zl {
    display:flex; align-items:center; gap:.35rem;
    font-size:.6875rem; color:var(--text-muted);
    font-family:var(--font-sans);
  }

  .nm-zl-btn {
    display:flex; align-items:center; gap:.35rem;
    font-size:.6875rem; color:var(--text-muted);
    background:var(--surface); border:1px solid var(--border);
    border-radius:999px; padding:.25rem .625rem;
    cursor:pointer; transition:all .15s;
    font-family:var(--font-sans);
  }
  .nm-zl-btn:hover { border-color:var(--accent); color:var(--accent); background:var(--accent-soft); }
  .nm-zl-btn.zone-active { border-color:#333; color:#111; background:rgba(255,239,0,.25); font-weight:600; }

  .nm-zs { width:12px; height:10px; border-radius:2px; border:1px solid rgba(0,0,0,.15); flex-shrink:0; }

  /* PANEL */
  .nm-panel { border:1px solid var(--border); border-radius:12px; overflow:hidden; margin-top:0; }
  .nm-ph { background:#2f5734; color:#fdfcf7; padding:.875rem 1.25rem; }
  .nm-ph-inner { display:flex; align-items:center; justify-content:space-between; gap:1rem; }
  .nm-sname { font-family:var(--font-serif); font-size:1.375rem; font-weight:600; letter-spacing:-.015em; }
  .nm-zname { font-size:.6875rem; font-weight:600; letter-spacing:.08em; text-transform:uppercase; opacity:.8; margin-top:.2rem; }
  .nm-close {
    background:rgba(255,255,255,.15); border:none; color:white; font-size:1.25rem; line-height:1;
    width:28px; height:28px; border-radius:6px; cursor:pointer;
    display:flex; align-items:center; justify-content:center; flex-shrink:0; transition:background .15s;
  }
  .nm-close:hover { background:rgba(255,255,255,.3); }

  .nm-pb { padding:1rem 1.25rem 1.25rem; background:var(--bg-elevated); display:grid; grid-template-columns:repeat(2,1fr); gap:.5rem 1.5rem; }
  .nm-leg-row { grid-column:1/-1; display:flex; gap:.75rem; padding-top:.625rem; border-top:1px solid var(--border); margin-top:.25rem; }
  .nm-cr { padding:.625rem 0; border-bottom:1px solid var(--border); }
  .nm-cr:nth-last-child(-n+2):not(.nm-leg-row) { border-bottom:none; }
  .nm-ch { display:flex; align-items:center; gap:.4rem; margin-bottom:.35rem; }
  .nm-dot { width:9px; height:9px; border-radius:50%; flex-shrink:0; }
  .nm-cn { font-weight:600; font-size:.875rem; color:var(--text); }
  .nm-lat { font-size:.625rem; color:var(--text-subtle); font-style:italic; margin-left:auto; }
  .nm-bar { display:grid !important; grid-template-columns:repeat(12,1fr) !important; gap:1.5px; margin-bottom:2px; }
  .nm-bc { height:13px; border-radius:2px; background:var(--surface-2); }
  .nm-bc.nm-p { opacity:.92; }
  .nm-bc.nm-h { opacity:.38; }
  .nm-mls { display:grid !important; grid-template-columns:repeat(12,1fr) !important; gap:1.5px; margin-bottom:.3rem; }
  .nm-ml { font-size:.5rem; color:var(--text-subtle); text-align:center; font-weight:500; }
  .nm-note { font-size:.6875rem; color:var(--text-muted); line-height:1.4; }
  .nm-li { display:flex; align-items:center; gap:.3rem; font-size:.6875rem; color:var(--text-subtle); }
  .nm-sw { width:16px; height:8px; border-radius:2px; }

  @media (max-width:640px) {
    .nm-pb { grid-template-columns:1fr; }
    .nm-cr:last-of-type { border-bottom:none; }
  }
</style>

<script>
(function() {
  const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const CC = {maize:'#e8a020',cassava:'#7a5c3a',yam:'#c04f1a',sorghum:'#8b6914',rice:'#4a90a4',groundnut:'#c8820a',cowpea:'#8b4513'};
  const CN = {maize:'Maize',cassava:'Cassava',yam:'Yam',sorghum:'Sorghum',rice:'Rice',groundnut:'Groundnut',cowpea:'Cowpea (Beans)'};
  const CL = {maize:'Zea mays',cassava:'Manihot esculenta',yam:'Dioscorea spp.',sorghum:'Sorghum bicolor',rice:'Oryza sativa',groundnut:'Arachis hypogaea',cowpea:'Vigna unguiculata'};
  const ZN = {sahel:'Sahel / Sudan Savanna',guinea:'Guinea Savanna',derived:'Derived Savanna / Middle Belt',forest_trans:'Forest-Savanna Transition',rainforest:'Rainforest / South-South'};
  const ZH = {sahel:'#8b6914',guinea:'#4a7c20',derived:'#2e7a2e',forest_trans:'#1e6040',rainforest:'#1a4810'};

  // UPDATED: Kwara and Kogi now in derived savanna
  const SZ = {
    Borno:'sahel',Yobe:'sahel',Jigawa:'sahel',Kano:'sahel',Katsina:'sahel',Sokoto:'sahel',Zamfara:'sahel',Kebbi:'sahel',
    Kaduna:'guinea',Niger:'guinea',FCT:'guinea',Nasarawa:'guinea',Plateau:'guinea',Taraba:'guinea',Adamawa:'guinea',Bauchi:'guinea',Gombe:'guinea',
    Benue:'derived',Kwara:'derived',Kogi:'derived',
    Oyo:'forest_trans',Osun:'forest_trans',Ekiti:'forest_trans',Ondo:'forest_trans',Ogun:'forest_trans',Lagos:'forest_trans',Edo:'forest_trans',Anambra:'forest_trans',Enugu:'forest_trans','Cross River':'forest_trans',Ebonyi:'forest_trans',
    Delta:'rainforest',Rivers:'rainforest',Bayelsa:'rainforest',Imo:'rainforest',Abia:'rainforest','Akwa Ibom':'rainforest',
  };

  const D = {
    sahel:{
      maize:{s:[[4,2,7,2]],n:'Single season. Plant May–Jun with first rains. Short-season varieties (90 days) preferred.'},
      cassava:{s:[[4,3,15,3]],n:'Limited in far North. Plant May–Jul, harvest 12–18 months later.'},
      yam:{s:[[3,2,8,2]],n:'Marginal zone. Plant Apr–May, harvest Aug–Sep. Supplemental irrigation needed.'},
      sorghum:{s:[[5,2,9,2]],n:'Primary staple. Plant Jun–Jul, harvest Sep–Oct. Drought-tolerant.'},
      rice:{s:[[5,2,8,2]],n:'Upland rice only. Jun–Jul planting, Sep harvest. Irrigation expands options.'},
      groundnut:{s:[[4,2,7,2]],n:'Major crop in Northern Nigeria. Plant May–Jun, harvest Aug–Sep.'},
      cowpea:{s:[[5,2,8,2]],n:'Drought-tolerant. Plant Jun–Jul, harvest Aug–Sep. Dual-purpose — grain and fodder.'},
    },
    guinea:{
      maize:{s:[[3,2,6,2],[7,2,10,2]],n:'Two seasons. Season 1: Apr–May → Jul–Aug. Season 2: Aug–Sep → Nov.'},
      cassava:{s:[[3,3,15,4]],n:'Plant Apr–Jun, harvest 12–18 months later. Major production zone.'},
      yam:{s:[[2,3,7,3]],n:'Plant Mar–May, harvest Aug–Oct. Well-drained, organic-rich soils needed.'},
      sorghum:{s:[[4,2,8,2]],n:'Plant May–Jun, harvest Sep–Oct. Kebbi and Niger are major producers.'},
      rice:{s:[[4,2,8,2]],n:'Plant May–Jun, harvest Aug–Sep. Kebbi and Niger are major rice states.'},
      groundnut:{s:[[3,2,7,3]],n:'Plant Apr–May, harvest Jul–Sep. Important in Kaduna, Niger, and Kwara.'},
      cowpea:{s:[[4,2,7,2]],n:'Plant May–Jun, harvest Jul–Aug. Widely intercropped with maize and sorghum.'},
    },
    derived:{
      maize:{s:[[3,2,6,2],[7,2,10,2]],n:'Two full seasons. Benue is a major maize belt. Kwara and Kogi also significant.'},
      cassava:{s:[[2,4,14,4]],n:'Year-round planting possible. Best Mar–Jun. Major production zone across all three states.'},
      yam:{s:[[1,3,7,3]],n:"Benue is Nigeria's top yam-producing state. Kwara and Kogi also important. Plant Feb–Apr, harvest Aug–Oct."},
      sorghum:{s:[[4,2,8,2]],n:'Plant May–Jun, harvest Sep–Oct. Grown in rotation with maize.'},
      rice:{s:[[4,3,8,2]],n:'Lowland and fadama rice. Plant May–Jul, harvest Sep–Oct.'},
      groundnut:{s:[[3,2,6,2]],n:'Plant Apr–May, harvest Jun–Aug. Kwara and Kogi are significant producers.'},
      cowpea:{s:[[3,2,6,2],[7,2,10,2]],n:'Two seasons possible. Intercropped with yam and maize across the zone.'},
    },
    forest_trans:{
      maize:{s:[[2,2,5,2],[7,2,10,2]],n:'Bimodal seasons. Season 1: Mar–Apr → Jun–Jul. Season 2: Aug–Sep → Nov.'},
      cassava:{s:[[2,4,14,4]],n:'Plant Mar–Jun, harvest 12–18 months later. Intercropped with maize.'},
      yam:{s:[[1,3,7,3]],n:'Plant Feb–Apr, harvest Aug–Oct. Cultural crop in Ondo, Ekiti, Edo, Ebonyi.'},
      sorghum:{s:[[3,2,7,2]],n:'Less common in this zone. Plant Apr–May, harvest Aug–Sep.'},
      rice:{s:[[2,2,6,2],[7,2,10,2]],n:'Two seasons. Ogun and Oyo are major rice-producing states.'},
      groundnut:{s:[[2,2,5,2]],n:'Season 1 predominant. Plant Mar–Apr, harvest May–Jun.'},
      cowpea:{s:[[2,2,5,2],[7,2,10,2]],n:'Two seasons. Intercropped with maize. Important protein source.'},
    },
    rainforest:{
      maize:{s:[[2,2,5,2],[7,2,10,2]],n:'Two seasons year-round. Higher disease pressure limits yields.'},
      cassava:{s:[[0,12,12,4]],n:'Year-round planting. Primary staple. Rivers, Imo, Delta are major producers.'},
      yam:{s:[[1,3,7,3]],n:'Plant Feb–Apr, harvest Aug–Oct. High humidity supports production.'},
      sorghum:{s:[[3,2,7,2]],n:'Rarely grown here. Apr–May planting, Aug–Sep harvest where practiced.'},
      rice:{s:[[3,3,7,2]],n:'Lowland and swamp rice. Plant Apr–Jun, harvest Aug–Oct.'},
      groundnut:{s:[[2,2,5,2]],n:'Season 1 only. Plant Mar–Apr, harvest May–Jun. Mainly smallholder production.'},
      cowpea:{s:[[2,2,5,2],[7,2,10,2]],n:'Grown in both seasons. Important protein crop despite humidity constraints.'},
    },
  };

  function buildBar(seasons, color) {
    const m = new Array(12).fill(0);
    seasons.forEach(([ps,pd,hs,hd]) => {
      for(let i=0;i<pd;i++) m[(ps+i)%12]=1;
      for(let i=0;i<hd;i++) { const idx=(hs+i)%12; if(!m[idx]) m[idx]=2; }
    });
    const cells = m.map((v,i) => {
      const cls = v===1?'nm-bc nm-p':v===2?'nm-bc nm-h':'nm-bc';
      const bg = v?'background:'+color:'';
      return '<div class="'+cls+'" style="'+bg+'" title="'+MONTHS[i]+'"></div>';
    }).join('');
    const lbls = MONTHS.map(l=>'<div class="nm-ml">'+l+'</div>').join('');
    return '<div class="nm-bar">'+cells+'</div><div class="nm-mls">'+lbls+'</div>';
  }

  function showState(name) {
    const zk = SZ[name]||'guinea';
    document.getElementById('nm-ph').style.background = ZH[zk];
    document.getElementById('nm-sname').textContent = name;
    document.getElementById('nm-zname').textContent = ZN[zk];
    const rows = Object.entries(D[zk]).map(([k,c]) =>
      '<div class="nm-cr">' +
        '<div class="nm-ch">' +
          '<div class="nm-dot" style="background:'+CC[k]+'"></div>' +
          '<span class="nm-cn">'+CN[k]+'</span>' +
          '<span class="nm-lat">'+CL[k]+'</span>' +
        '</div>' +
        buildBar(c.s, CC[k]) +
        '<p class="nm-note">'+c.n+'</p>' +
      '</div>'
    ).join('');
    document.getElementById('nm-pb').innerHTML = rows +
      '<div class="nm-leg-row">' +
        '<div class="nm-li"><div class="nm-sw" style="background:#4a7c50;opacity:.9"></div>Planting window</div>' +
        '<div class="nm-li"><div class="nm-sw" style="background:#4a7c50;opacity:.35"></div>Growing / harvest</div>' +
      '</div>';
    document.getElementById('nm-panel').style.display = 'block';
    setTimeout(() => document.getElementById('nm-panel').scrollIntoView({behavior:'smooth',block:'nearest'}), 50);
  }

  function deselect() {
    document.querySelectorAll('#nm-svg .state').forEach(s=>s.classList.remove('active'));
    document.getElementById('nm-panel').style.display = 'none';
    selectedState = null;
  }

  function clearZoneHighlight() {
    document.querySelectorAll('#nm-svg .state').forEach(s=>s.classList.remove('zone-highlighted'));
    document.querySelectorAll('.nm-zl-btn').forEach(b=>b.classList.remove('zone-active'));
    activeZone = null;
  }

  let selectedState = null;
  let activeZone = null;

  // State clicks
  document.querySelectorAll('#nm-svg .state').forEach(el => {
    el.addEventListener('click', e => {
      e.stopPropagation();
      const name = el.dataset.state;
      if(selectedState===name) { deselect(); return; }
      document.querySelectorAll('#nm-svg .state').forEach(s=>s.classList.remove('active'));
      el.classList.add('active');
      selectedState = name;
      showState(name);
    });
  });

  // Zone legend clicks
  document.querySelectorAll('.nm-zl-btn').forEach(btn => {
    btn.addEventListener('click', e => {
      e.stopPropagation();
      const zone = btn.dataset.zone;

      if(activeZone === zone) {
        // Toggle off
        clearZoneHighlight();
        return;
      }

      // Clear previous zone
      clearZoneHighlight();
      // Deselect any open state panel
      deselect();

      // Highlight all states in this zone
      document.querySelectorAll('#nm-svg .state').forEach(s => {
        if(s.dataset.zone === zone) s.classList.add('zone-highlighted');
      });
      btn.classList.add('zone-active');
      activeZone = zone;
    });
  });

  // Click outside → clear all
  document.addEventListener('click', e => {
    if(!e.target.closest('#nm-svg') && !e.target.closest('#nm-panel') && !e.target.closest('.nm-zl-btn')) {
      deselect();
      clearZoneHighlight();
    }
  });

  // Close button
  document.getElementById('nm-close').addEventListener('click', () => { deselect(); clearZoneHighlight(); });

  // ── ZOOM / PAN ──
  const container = document.getElementById('nm-map-container');
  const svg = document.getElementById('nm-svg');
  const resetBtn = document.getElementById('nm-reset-btn');
  let scale=1, tx=0, ty=0, isDragging=false, lastX=0, lastY=0;
  const MIN_SCALE=1, MAX_SCALE=6;

  function applyTransform() {
    svg.style.transform = 'translate('+tx+'px,'+ty+'px) scale('+scale+')';
    resetBtn.style.display = scale>1.05?'flex':'none';
  }

  function clamp(v,a,b){ return Math.min(Math.max(v,a),b); }

  function clampTrans() {
    const cw=container.clientWidth, ch=container.clientHeight;
    tx=clamp(tx,cw-cw*scale,0); ty=clamp(ty,ch-ch*scale,0);
  }

  resetBtn.addEventListener('click', e=>{ e.stopPropagation(); scale=1;tx=0;ty=0; applyTransform(); });

  let lastDist=0;
  function touchDist(t){ const dx=t[0].clientX-t[1].clientX,dy=t[0].clientY-t[1].clientY; return Math.sqrt(dx*dx+dy*dy); }
  function touchMid(t){ return {x:(t[0].clientX+t[1].clientX)/2,y:(t[0].clientY+t[1].clientY)/2}; }

  container.addEventListener('touchstart', e=>{
    if(e.touches.length===2){ e.preventDefault(); lastDist=touchDist(e.touches); }
    else if(e.touches.length===1&&scale>1){ isDragging=true; lastX=e.touches[0].clientX; lastY=e.touches[0].clientY; }
  },{passive:false});

  container.addEventListener('touchmove', e=>{
    if(e.touches.length===2){
      e.preventDefault();
      const d=touchDist(e.touches), mid=touchMid(e.touches);
      const delta=d/lastDist, rect=container.getBoundingClientRect();
      const ox=mid.x-rect.left, oy=mid.y-rect.top;
      const ns=clamp(scale*delta,MIN_SCALE,MAX_SCALE), sd=ns/scale;
      tx=ox-sd*(ox-tx); ty=oy-sd*(oy-ty); scale=ns;
      clampTrans(); applyTransform(); lastDist=d;
    } else if(e.touches.length===1&&isDragging){
      e.preventDefault();
      tx+=e.touches[0].clientX-lastX; ty+=e.touches[0].clientY-lastY;
      lastX=e.touches[0].clientX; lastY=e.touches[0].clientY;
      clampTrans(); applyTransform();
    }
  },{passive:false});

  container.addEventListener('touchend', e=>{ if(e.touches.length<2) isDragging=false; });

  container.addEventListener('wheel', e=>{
    e.preventDefault();
    const rect=container.getBoundingClientRect();
    const ox=e.clientX-rect.left, oy=e.clientY-rect.top;
    const delta=e.deltaY<0?1.12:0.89;
    const ns=clamp(scale*delta,MIN_SCALE,MAX_SCALE), sd=ns/scale;
    tx=ox-sd*(ox-tx); ty=oy-sd*(oy-ty); scale=ns;
    clampTrans(); applyTransform();
  },{passive:false});

  container.addEventListener('mousedown', e=>{ if(scale>1){ isDragging=true; lastX=e.clientX; lastY=e.clientY; } });
  document.addEventListener('mousemove', e=>{ if(!isDragging) return; tx+=e.clientX-lastX; ty+=e.clientY-lastY; lastX=e.clientX; lastY=e.clientY; clampTrans(); applyTransform(); });
  document.addEventListener('mouseup', ()=>{ isDragging=false; });
})();
</script>
