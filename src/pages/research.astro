            </p>
          </li>
        </ol>
      </div>
    </section>

    <!-- ============================================================
         SELECTED PRESENTATIONS
         ============================================================ -->
    <section class="section">
      <div class="container-narrow">
        <h2>Selected presentations</h2>
        <dl class="pres-list">
          <div>
            <dt>2025</dt>
            <dd>
              <strong>International Silage Conference</strong> — Research talk:
              <em>Integrated management of vomitoxin in corn silage fields and
