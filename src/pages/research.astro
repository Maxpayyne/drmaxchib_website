      </div>
    </section>
  </article>
</Layout>

<style>
  .page-header {
    padding-block: clamp(3rem, 8vh, 5rem) 2rem;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin: 0 0 1.5rem;
  }

  .page-header h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    font-weight: 500;
    margin: 0 0 1.5rem;
    max-width: 22ch;
  }

  .lede {
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.55;
    color: var(--text-muted);
    max-width: 60ch;
    margin: 0;
  }

  .section { padding-block: clamp(2.5rem, 6vh, 4rem); }
  .section-tinted { background-color: var(--surface); }

  h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin: 0 0 2rem;
    letter-spacing: -0.02em;
    font-weight: 500;
  }

  .subhead {
    font-size: 1.25rem;
    margin: 3rem 0 1.5rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .focus-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .focus-list li {
    padding: 1.25rem 0;
    border-top: 1px solid var(--border);
    color: var(--text);
    line-height: 1.6;
  }

  .focus-list li:last-child { border-bottom: 1px solid var(--border); }

  .focus-list strong { color: var(--accent); }

  .pub-list {
    list-style: none;
    counter-reset: pub;
    padding: 0;
    margin: 0;
  }

  .pub-list li {
    counter-increment: pub;
    padding: 1.5rem 0 1.5rem 3rem;
    border-top: 1px solid var(--border);
    position: relative;
    line-height: 1.55;
  }

  .pub-list li::before {
    content: counter(pub, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-subtle);
  }

  .pub-list li:last-child { border-bottom: 1px solid var(--border); }

  .pub-list p { margin: 0 0 0.5rem; }
  .pub-list p:last-child { margin-bottom: 0; }

  .pub-link a {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent);
    text-decoration: none;
  }

  .pub-link a:hover { text-decoration: underline; }

  .pres-list {
    margin: 0;
    padding: 0;
  }

  .pres-list > div {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 2rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--border);
  }

  .pres-list > div:last-child { border-bottom: 1px solid var(--border); }

  .pres-list dt {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent);
    padding-top: 0.2rem;
  }

  .pres-list dd {
    margin: 0;
    color: var(--text);
    line-height: 1.6;
  }

  .poster-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent);
    text-decoration: none;
    margin-top: 0.5rem;
  }
  .poster-link:hover { text-decoration: underline; }

  .poster-preview {
    margin: 1.25rem 0 0;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--border);
    max-width: 700px;
  }

  .poster-preview img {
    width: 100%;
    display: block;
    transition: opacity 0.2s ease;
  }

  .poster-preview a:hover img { opacity: 0.92; }

  .poster-preview figcaption {
    padding: 0.625rem 1rem;
    font-size: 0.8125rem;
    color: var(--text-subtle);
    font-style: italic;
    background-color: var(--surface);
    text-align: center;
  }

  @media (max-width: 768px) {
    .pub-list li { padding-left: 0; }
    .pub-list li::before {
      position: static;
      display: block;
      margin-bottom: 0.5rem;
    }
    .pres-list > div { grid-template-columns: 1fr; gap: 0.25rem; }
  }
</style>
