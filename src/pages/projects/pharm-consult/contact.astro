---
// Lynik Innovations — Contact (concept mockup)
import './pharm-consult.css';
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Lynik Innovations — Contact (Concept)</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap"
  />
</head>
<body>
  <div class="page">

    <header class="nav">
      <div class="wrap nav-row">
        <div class="wordmark-row">
          <div class="mark"><span>LKI</span></div>
          <div class="wordmark">
            <span class="name">LYNIK INNOVATIONS</span>
            <span class="tag">Life Sciences Consulting &amp; Solutions</span>
          </div>
        </div>
        <nav class="nav-links">
          <a href="/projects/pharm-consult">Home</a>
          <a href="/projects/pharm-consult/about">About</a>
          <a href="/projects/pharm-consult/services">Services</a>
          <a href="/projects/pharm-consult/who-we-help">Who We Help</a>
          <a href="/projects/pharm-consult/contact" class="active">Contact</a>
        </nav>
        <a href="/projects/pharm-consult/contact" class="btn btn-gold nav-cta">Let's Talk</a>
      </div>
    </header>

    <section class="hero-section">
      <div class="wrap hero-row">
        <div class="hero">
          <span class="eyebrow">CONTACT</span>
          <h1>Let's Start a Conversation.</h1>
          <p class="lede2">Tell us about your Medical Information needs.</p>
        </div>
        <div class="hero-media">
          <div class="photo-block"><span class="cap">Photo — desk, laptop, LKI mug</span></div>
        </div>
      </div>
    </section>

    <section style="padding-top:0">
      <div class="wrap" style="display:grid;grid-template-columns:1fr 1.3fr;gap:0;background:var(--sage-tint);border-radius:10px;overflow:hidden">

        <div style="padding:48px 44px;display:flex;flex-direction:column;gap:22px">
          <div>
            <span class="eyebrow">WE'RE HERE TO HELP</span>
            <h2 style="margin-top:10px;font-size:28px">Your Goals.<br/>Our Expertise.</h2>
          </div>
          <p style="font-size:15px;color:var(--ink)">Whether you're preparing for a launch, building your Medical Information function, strengthening existing operations, or exploring AI-enabled workflows, Lynik Innovations is here to help.</p>

          <div style="display:flex;flex-direction:column;gap:18px;margin-top:6px">
            <div style="display:flex;gap:14px;align-items:center">
              <div class="icon-circle" style="background:var(--white)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="var(--forest)" stroke-width="1.5"/><path d="M4 6.5l8 6 8-6" stroke="var(--forest)" stroke-width="1.4"/></svg></div>
              <div>
                <div style="font-size:13px;color:var(--gold-deep);font-weight:600">Email Us</div>
                <div style="font-size:14.5px;color:var(--forest);font-weight:500">info@lynikinnovations.com</div>
              </div>
            </div>
            <div style="display:flex;gap:14px;align-items:center">
              <div class="icon-circle" style="background:var(--forest)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="2" y="2" width="20" height="20" rx="3" stroke="var(--ivory)" stroke-width="1.5"/><circle cx="7.2" cy="7.2" r="1.1" fill="var(--ivory)"/><path d="M6.2 10.5v7.3M10.4 10.5v7.3M10.4 13.6c0-1.8 1.2-3.1 2.9-3.1s2.7 1.1 2.7 3.3v4" stroke="var(--ivory)" stroke-width="1.4" stroke-linecap="round"/></svg></div>
              <div>
                <div style="font-size:13px;color:var(--gold-deep);font-weight:600">Connect With Us</div>
                <div style="font-size:14.5px;color:var(--forest);font-weight:500">LinkedIn</div>
              </div>
            </div>
          </div>

          <div style="margin-top:auto;padding-top:24px;border-top:1px solid var(--sage-line);font-family:'Source Serif 4',serif;font-style:italic;font-size:18px;color:var(--forest)">
            Let's find the right solution for your team.
          </div>
        </div>

        <div style="background:var(--white);margin:20px 20px 20px 0;border-radius:8px;padding:40px 40px;display:flex;flex-direction:column;gap:22px">
          <div>
            <h2 style="font-size:24px">Send Us a Message</h2>
            <p style="font-size:14.5px;color:var(--ink);margin-top:6px">Fill out the form below and we'll get back to you as soon as possible.</p>
          </div>
          <div class="form-grid">
            <div class="field">
              <label for="name">Name *</label>
              <input id="name" type="text" placeholder="Your full name" />
            </div>
            <div class="field">
              <label for="company">Company *</label>
              <input id="company" type="text" placeholder="Your company name" />
            </div>
            <div class="field">
              <label for="title">Title *</label>
              <input id="title" type="text" placeholder="Your title" />
            </div>
            <div class="field">
              <label for="email">Business Email *</label>
              <input id="email" type="email" placeholder="yourname@company.com" />
            </div>
          </div>
          <div class="field">
            <label for="phone">Phone (optional)</label>
            <input id="phone" type="tel" placeholder="Your phone number" />
          </div>
          <div class="field">
            <label for="topic">What can we help you with? *</label>
            <select id="topic">
              <option value="">Select an option</option>
              <option>Launch Readiness</option>
              <option>Medical Information Operations</option>
              <option>MI Content Development</option>
              <option>Inquiry &amp; Escalation Support</option>
              <option>Medical Review Support</option>
              <option>Process Improvement</option>
              <option>Interim Medical Information Support</option>
              <option>Fractional Medical Information Support</option>
              <option>Other</option>
            </select>
          </div>
          <div class="field">
            <label for="needs">Tell us about your needs *</label>
            <textarea id="needs" rows="4" placeholder="Please share a few details about your request, timeline, or any specific goals you have in mind."></textarea>
          </div>
          <button type="button" class="btn btn-dark" style="width:100%;padding-block:15px">Submit Inquiry</button>
        </div>

      </div>
    </section>

    <footer>
      <div class="wrap">
        <div class="footer-top" style="align-items:center">
          <div class="wordmark-row" style="padding-right:28px;border-right:1px solid rgba(247,245,239,.2)">
            <div class="mark"><span>LKI</span></div>
            <div class="wordmark">
              <span class="name">LYNIK INNOVATIONS</span>
              <span class="tag">Life Sciences Consulting &amp; Solutions</span>
            </div>
          </div>
          <div style="font-family:'Source Serif 4',serif;font-style:italic;font-size:16px;color:var(--ivory);flex-grow:1">
            Expertise today.<br/>Solutions for what's next.
          </div>
          <div class="social" style="gap:16px">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" stroke="rgba(247,245,239,.7)" stroke-width="1.4"/><path d="M4 6.5l8 6 8-6" stroke="rgba(247,245,239,.7)" stroke-width="1.3"/></svg>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="3" stroke="rgba(247,245,239,.7)" stroke-width="1.4"/><circle cx="7.2" cy="7.2" r="1.1" fill="rgba(247,245,239,.7)"/><path d="M6.2 10.5v7.3M10.4 10.5v7.3M10.4 13.6c0-1.8 1.2-3.1 2.9-3.1s2.7 1.1 2.7 3.3v4" stroke="rgba(247,245,239,.7)" stroke-width="1.4" stroke-linecap="round"/></svg>
          </div>
        </div>
        <div class="footer-bottom">
          <nav class="footer-nav">
            <a href="/projects/pharm-consult">Home</a>
            <a href="/projects/pharm-consult/about">About</a>
            <a href="/projects/pharm-consult/services">Services</a>
            <a href="/projects/pharm-consult/who-we-help">Who We Help</a>
            <a href="/projects/pharm-consult/contact">Contact</a>
          </nav>
          <span>&copy; 2026 Lynik Innovations. All rights reserved.</span>
        </div>
      </div>
    </footer>

  </div>
</body>
</html>