---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { PROJECT_CATEGORIES } from '../../consts';

const allProjects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => {
    if (a.data.order !== b.data.order) return a.data.order - b.data.order;
    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  });

const grouped = {
  research: allProjects.filter((p) => p.data.category === 'research'),
  civic: allProjects.filter((p) => p.data.category === 'civic'),
  pet: allProjects.filter((p) => p.data.category === 'pet'),
};
---

<Layout
  title="Projects"
  description="Research projects, civic technology builds, and personal coding experiments by Maxwell O. Chibuogwu — including AI tools for African agriculture."
>
  <article class="projects-page">
    <header class="page-header">
      <div class="container-narrow">
        <p class="eyebrow reveal">Projects</p>
        <h1 class="reveal reveal-delay-1">
          Things I'm building, breaking, and shipping.
        </h1>
        <p class="lede reveal reveal-delay-2">
          A growing portfolio of research projects, civic-tech builds for the
          Nigerian ecosystem, and the occasional pet experiment in data
          visualization. Most code lives on GitHub; the writing on each lives
          here.
        </p>
      </div>
    </header>

    <section class="section">
      <div class="container-wide">
        {Object.entries(grouped).map(([key, projects]) => {
          const cat = PROJECT_CATEGORIES[key as keyof typeof PROJECT_CATEGORIES];
          if (projects.length === 0) {
            return (
              <section class="cat-section">
                <h2 class="cat-heading">{cat.name}</h2>
                <p class="empty">
                  Nothing here yet — first projects in this category coming
                  soon.
                </p>
              </section>
            );
          }
          return (
            <section class="cat-section">
              <h2 class="cat-heading">{cat.name}</h2>
              <ul class="proj-grid">
                {projects.map((p) => (
                  <li>
                    <a href={`/projects/${p.id}`} class="proj-card">
                      <header class="proj-card-head">
                        <span class="proj-status" data-status={p.data.status}>
                          {p.data.status}
                        </span>
                        <h3>{p.data.title}</h3>
                      </header>
                      <p class="proj-desc">{p.data.description}</p>
                      {p.data.stack.length > 0 && (
                        <ul class="proj-stack">
                          {p.data.stack.slice(0, 5).map((tech) => (
                            <li>{tech}</li>
                          ))}
                        </ul>
                      )}
                      <span class="proj-cta">View project →</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          );
        })}
      </div>
    </section>
  </article>
</Layout>

<style>
  .page-header {
    padding-block: clamp(3rem, 8vh, 5rem) 2rem;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin: 0 0 1.5rem;
  }

  .page-header h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    font-weight: 500;
    margin: 0 0 1.5rem;
    max-width: 22ch;
  }

  .lede {
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.55;
    color: var(--text-muted);
    max-width: 60ch;
    margin: 0;
  }

  .section {
    padding-block: clamp(2rem, 5vh, 3rem) clamp(3rem, 8vh, 6rem);
  }

  .cat-section {
    margin-bottom: 4rem;
  }

  .cat-heading {
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text);
    margin: 0 0 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .empty {
    color: var(--text-subtle);
    font-style: italic;
    padding: 1rem 0;
  }

  .proj-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .proj-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    height: 100%;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .proj-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--accent) 40%, var(--border));
    box-shadow: 0 8px 24px -12px color-mix(in oklab, var(--accent) 25%, transparent);
  }

  .proj-card-head h3 {
    font-size: 1.375rem;
    margin: 0.5rem 0 0;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .proj-status {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background-color: var(--surface-2);
    color: var(--text-muted);
  }

  .proj-status[data-status="shipped"] {
    background-color: var(--accent-soft);
    color: var(--accent);
  }

  .proj-status[data-status="in-progress"] {
    background-color: color-mix(in oklab, #d97706 15%, transparent);
    color: #d97706;
  }

  :global([data-theme="dark"]) .proj-status[data-status="in-progress"] { color: #fbbf24; }

  .proj-status[data-status="concept"] {
    background-color: color-mix(in oklab, #6366f1 15%, transparent);
    color: #6366f1;
  }

  .proj-desc {
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
    font-size: 0.9375rem;
    flex: 1;
  }

  .proj-stack {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .proj-stack li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-subtle);
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  .proj-cta {
    font-size: 0.875rem;
    color: var(--accent);
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .proj-grid { grid-template-columns: 1fr; }
  }
</style>
